# ════════════════════════════════════════════════════════════════════
# Plataforma de Agendas para Capacitaciones - Backend Configuration
# ════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────
# Server Configuration
# ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ────────────────────────────────────────────────────────────────────
# Database Configuration (PostgreSQL)
# ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:password@localhost:5432/capacitaciones

# Drizzle Studio (opcional)
# Si quieres usar Drizzle Studio para inspeccionar la BD
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capacitaciones
DB_USER=usuario
DB_PASSWORD=password

# ────────────────────────────────────────────────────────────────────
# JWT Configuration
# ────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRE=7d

# Refresh Token
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRE=30d

# ────────────────────────────────────────────────────────────────────
# Google OAuth 2.0
# ────────────────────────────────────────────────────────────────────
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ────────────────────────────────────────────────────────────────────
# Google Calendar API
# ────────────────────────────────────────────────────────────────────
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key

# ────────────────────────────────────────────────────────────────────
# Microsoft OAuth 2.0 (Azure AD)
# ────────────────────────────────────────────────────────────────────
# Obtener en: https://portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=your_azure_app_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/auth/outlook/callback

# ────────────────────────────────────────────────────────────────────
# Microsoft Graph API (Outlook Calendar)
# ────────────────────────────────────────────────────────────────────
MICROSOFT_GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0

# ────────────────────────────────────────────────────────────────────
# Email Service (SendGrid o Resend)
# ────────────────────────────────────────────────────────────────────
# Opción 1: SendGrid (obtener en https://sendgrid.com)
SENDGRID_API_KEY=your_sendgrid_api_key

# Opción 2: Resend (obtener en https://resend.com)
# RESEND_API_KEY=your_resend_api_key

# Configuración de email
EMAIL_FROM=noreply@tuempresa.com
EMAIL_FROM_NAME=Plataforma Capacitaciones

# ────────────────────────────────────────────────────────────────────
# CORS Configuration
# ────────────────────────────────────────────────────────────────────
# URLs permitidas para CORS (separadas por comas)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ────────────────────────────────────────────────────────────────────
# Frontend URL (para links en emails)
# ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────
# Security
# ────────────────────────────────────────────────────────────────────
# Bcrypt rounds (10 recomendado para balance seguridad/performance)
BCRYPT_ROUNDS=10

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ────────────────────────────────────────────────────────────────────
# Logging
# ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ────────────────────────────────────────────────────────────────────
# Timezone
# ────────────────────────────────────────────────────────────────────
TZ=America/Mexico_City

# ────────────────────────────────────────────────────────────────────
# Feature Flags (opcional)
# ────────────────────────────────────────────────────────────────────
ENABLE_GOOGLE_CALENDAR=true
ENABLE_OUTLOOK_CALENDAR=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_EMAIL_REMINDERS=true

# ────────────────────────────────────────────────────────────────────
# Development Tools
# ────────────────────────────────────────────────────────────────────
# Mostrar SQL queries en consola
DEBUG_SQL=false

# ════════════════════════════════════════════════════════════════════
# Notas de Configuración
# ════════════════════════════════════════════════════════════════════
#
# 1. NUNCA subir este archivo a Git con valores reales
# 2. En producción, usa variables de entorno del servidor
# 3. JWT_SECRET debe ser diferente en desarrollo y producción
# 4. DATABASE_URL debe tener credenciales seguras en producción
# 5. CORS_ORIGIN debe restringirse en producción
#
# ════════════════════════════════════════════════════════════════════
